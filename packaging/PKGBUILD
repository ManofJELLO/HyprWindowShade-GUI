# Maintainer: Eric Trantina
#
# Builds a package from source. This is not what is on the AUR - that is
# hyprwindowshade-gui-bin, in packaging/aur-bin, which installs the binary
# from the GitHub release instead. Keep this one for building your own.
pkgname=hyprwindowshade-gui
_reponame=HyprWindowShade-GUI
pkgver=0.1.0
pkgrel=1
pkgdesc="Qt Quick front end for the HyprWindowShade Hyprland plugin"
arch=('x86_64')
url="https://github.com/ManofJELLO/hyprwindowshade-gui"
license=('MIT')
depends=('qt6-base' 'qt6-declarative')
makedepends=('cargo')
optdepends=('hyprland: the compositor this configures'
            'hyprwindowshade: the plugin this configures'
            'hyprpm: the Plugin page, which installs and reloads the plugin'
            'grim: the shader preview, which reads frames out of a nested compositor'
            'swaybg: your wallpaper behind the shader preview'
            'kitty: a terminal for the preview window and "Run in a terminal" (foot, alacritty, ghostty, wezterm, konsole or xterm will do as well)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$_reponame-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    # build() is --frozen, which is --offline: everything it compiles has to
    # be here before the network goes away.
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_reponame-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

check() {
    cd "$_reponame-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    # Only the engine is tested; the UI needs a compositor.
    cargo test --frozen -p hws-core
}

package() {
    cd "$_reponame-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
}
